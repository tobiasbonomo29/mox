{%- comment -%}
  MOX · Certificados. Los certificados se cargan una sola vez en Configuración
  del tema → MOX · Certificados y se comparten con la ficha de producto.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign cert_count = 0
  for n in (1..3)
    assign kn = 'mox_cert_' | append: n | append: '_name'
    if settings[kn] != blank
      assign cert_count = cert_count | plus: 1
    endif
  endfor
-%}
{%- if cert_count > 0 or request.design_mode -%}
<section class="mox-section{% if s.surface %} mox-section--surface{% endif %}" id="certificados" aria-labelledby="mox-certs-{{ section.id }}">
  <div class="mox-container">
    <div class="mox-section__head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="mox-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="mox-heading" id="mox-certs-{{ section.id }}">{{ s.heading | default: settings.mox_cert_title }}</h2>
      </div>
    </div>
    {%- render 'mox-certificates', hide_heading: true, text: s.text -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Certificados MOX",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Los certificados (nombre y PDF) se cargan en Configuración del tema → MOX · Certificados."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Calidad verificada"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "info": "Vacío = usa el título configurado en MOX · Certificados."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "info": "Vacío = usa el texto configurado en MOX · Certificados."
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Fondo blanco",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Certificados MOX"
    }
  ]
}
{% endschema %}
