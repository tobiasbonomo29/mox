        {
          "type": "text",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto secundario"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Resultados y beneficios",
      "blocks": [
        {
          "type": "result",
          "settings": { "percent": 0, "text": "Escribí acá el primer resultado real de tu encuesta." }
        },
        {
          "type": "result",
          "settings": { "percent": 0, "text": "Escribí acá el segundo resultado real de tu encuesta." }
        },
        {
          "type": "result",
          "settings": { "percent": 0, "text": "Escribí acá el tercer resultado real de tu encuesta." }
        },
        {
          "type": "benefit",
          "settings": { "icon": "truck", "title": "Envío gratis a todo el país" }
        },
        {
          "type": "benefit",
          "settings": { "icon": "heart", "title": "Probalo sin riesgo por 60 días" }
        },
        {
          "type": "benefit",
          "settings": { "icon": "support", "title": "Atención al cliente" }
        },
        {
          "type": "benefit",
          "settings": { "icon": "shield", "title": "Pagos seguros" }
        }
      ]
    }
  ]
}
{% endschema %}