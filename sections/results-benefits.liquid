      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "result_gap",
      "label": "Espacio entre resultados",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
