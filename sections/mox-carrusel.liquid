{%- comment -%}
  MOX — Carrusel de productos ("También te puede gustar")
  Toma los productos de una colección elegida desde el editor.
{%- endcomment -%}

{%- assign uid = section.id -%}
{%- assign col = section.settings.collection -%}

<div id="mox-carr-{{ uid }}" class="mox-carr">
  <div class="mox-carr__container">

  <style>
    #mox-carr-{{ uid }} {
      background: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    }
    #mox-carr-{{ uid }} * { box-sizing: border-box; }
    #mox-carr-{{ uid }} .mox-carr__container {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      position: relative;
    }
    #mox-carr-{{ uid }} .mox-carr__title {
      font-size: clamp(20px, 2.4vw, 27px);
      font-weight: 600;
      line-height: 1.2;
      margin: 0 0 22px;
    }

    #mox-carr-{{ uid }} .mox-carr__track {
      display: flex;
      gap: {{ section.settings.gap }}px;
      overflow-x: auto;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 4px;
    }
    #mox-carr-{{ uid }} .mox-carr__track::-webkit-scrollbar { display: none; }

    #mox-carr-{{ uid }} .mox-card {
      flex: 0 0 {{ section.settings.card_width }}px;
      max-width: 80vw;
      scroll-snap-align: start;
      text-decoration: none;
      color: inherit;
      display: block;
    }
    #mox-carr-{{ uid }} .mox-card__media {
      background: {{ section.settings.media_bg }};
      aspect-ratio: 1 / 1;
      overflow: hidden;
      margin-bottom: 14px;
    }
    #mox-carr-{{ uid }} .mox-card__media img,
    #mox-carr-{{ uid }} .mox-card__media svg {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      transition: transform .35s ease;
    }
    #mox-carr-{{ uid }} .mox-card:hover .mox-card__media img {
      transform: scale(1.04);
    }
    #mox-carr-{{ uid }} .mox-card:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 4px;
    }
    #mox-carr-{{ uid }} .mox-card__badge {
      font-size: 14.5px;
      font-weight: 600;
      line-height: 1.3;
      margin: 0 0 3px;
    }
    #mox-carr-{{ uid }} .mox-card__badge--new { color: {{ section.settings.new_color }}; }
    #mox-carr-{{ uid }} .mox-card__badge--sale { color: {{ section.settings.sale_color }}; }
    #mox-carr-{{ uid }} .mox-card__name {
      font-size: 15.5px;
      font-weight: 700;
      line-height: 1.35;
      margin: 0 0 2px;
    }
    #mox-carr-{{ uid }} .mox-card__type {
      font-size: 15px;
      line-height: 1.35;
      opacity: .55;
      margin: 0 0 6px;
    }
    #mox-carr-{{ uid }} .mox-card__prices {
      display: flex;
      align-items: baseline;
      gap: 10px;
      flex-wrap: wrap;
      font-size: 15.5px;
      font-weight: 700;
    }
    #mox-carr-{{ uid }} .mox-card__was {
      font-weight: 400;
      text-decoration: line-through;
      opacity: .5;
    }
    #mox-carr-{{ uid }} .mox-card__off {
      font-size: 14.5px;
      font-weight: 600;
      color: {{ section.settings.off_color }};
      margin: 4px 0 0;
    }

    /* ---------- Flechas ---------- */
    #mox-carr-{{ uid }} .mox-carr__arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 0;
      background: {{ section.settings.arrow_bg }};
      color: {{ section.settings.arrow_color }};
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 2;
      box-shadow: 0 2px 10px rgba(0,0,0,.16);
      transition: opacity .2s ease;
    }
    #mox-carr-{{ uid }} .mox-carr__arrow[disabled] {
      opacity: 0;
      pointer-events: none;
    }
    #mox-carr-{{ uid }} .mox-carr__arrow--prev { left: -8px; }
    #mox-carr-{{ uid }} .mox-carr__arrow--next { right: -8px; }
    #mox-carr-{{ uid }} .mox-carr__arrow svg { width: 16px; height: 16px; }
    #mox-carr-{{ uid }} .mox-carr__arrow:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 3px;
    }

    @media (max-width: 749px) {
      #mox-carr-{{ uid }} .mox-card { flex-basis: {{ section.settings.card_width | times: 0.72 | round }}px; }
      #mox-carr-{{ uid }} .mox-carr__arrow { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      #mox-carr-{{ uid }} .mox-carr__track { scroll-behavior: auto; }
      #mox-carr-{{ uid }} .mox-card__media img { transition: none; }
    }
  </style>

  {%- if section.settings.title != blank -%}
    <h2 class="mox-carr__title">{{ section.settings.title }}</h2>
  {%- endif -%}

  {%- if section.settings.show_arrows -%}
    <button class="mox-carr__arrow mox-carr__arrow--prev" type="button" aria-label="Anterior" data-mox-prev disabled>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="mox-carr__arrow mox-carr__arrow--next" type="button" aria-label="Siguiente" data-mox-next>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  {%- endif -%}

  <div class="mox-carr__track" data-mox-track>
    {%- if col != blank and col.products_count > 0 -%}
      {%- for product in col.products limit: section.settings.max_products -%}
        <a class="mox-card" href="{{ product.url }}">
          <div class="mox-card__media">
            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 800 | image_tag:
                  loading: 'lazy',
                  alt: product.title,
                  widths: '300, 500, 800' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          {%- if product.compare_at_price > product.price -%}
            <p class="mox-card__badge mox-card__badge--sale">{{ section.settings.sale_label }}</p>
          {%- elsif section.settings.new_tag != blank and product.tags contains section.settings.new_tag -%}
            <p class="mox-card__badge mox-card__badge--new">{{ section.settings.new_label }}</p>
          {%- endif -%}

          <p class="mox-card__name">{{ product.title }}</p>

          {%- if section.settings.show_type and product.type != blank -%}
            <p class="mox-card__type">{{ product.type }}</p>
          {%- endif -%}

          <div class="mox-card__prices">
            {%- if product.compare_at_price > product.price -%}
              <span class="mox-card__was">{{ product.compare_at_price | money }}</span>
            {%- endif -%}
            <span>{{ product.price | money }}</span>
          </div>

          {%- if section.settings.show_off and product.compare_at_price > product.price -%}
            {%- assign off = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
            <p class="mox-card__off">{{ off }}% de descuento</p>
          {%- endif -%}
        </a>
      {%- endfor -%}
    {%- else -%}
      <p style="opacity:.6">Elegí una colección desde el editor para mostrar productos acá.</p>
    {%- endif -%}
  </div>

  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('mox-carr-{{ uid }}');
    if (!root || root.dataset.moxReady === 'true') return;
    root.dataset.moxReady = 'true';

    var track = root.querySelector('[data-mox-track]');
    var prev = root.querySelector('[data-mox-prev]');
    var next = root.querySelector('[data-mox-next]');
    if (!track) return;

    function step() {
      var card = track.querySelector('.mox-card');
      if (!card) return 320;
      return card.getBoundingClientRect().width + {{ section.settings.gap }};
    }

    function refresh() {
      if (!prev || !next) return;
      var max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    }

    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    track.addEventListener('scroll', refresh);
    window.addEventListener('resize', refresh);
    refresh();
  })();
</script>

{% schema %}
{
  "name": "Carrusel de productos",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "También te puede gustar"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección",
      "info": "De acá salen los productos que se muestran."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Cantidad máxima de productos",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_type",
      "label": "Mostrar el tipo de producto",
      "info": "Es el campo \"Tipo de producto\" de cada ficha.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar flechas",
      "default": true
    },

    {
      "type": "header",
      "content": "Etiquetas"
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Texto para productos en oferta",
      "default": "SALE"
    },
    {
      "type": "checkbox",
      "id": "show_off",
      "label": "Mostrar el porcentaje de descuento",
      "default": true
    },
    {
      "type": "text",
      "id": "new_label",
      "label": "Texto para productos nuevos",
      "default": "Lo nuevo"
    },
    {
      "type": "text",
      "id": "new_tag",
      "label": "Etiqueta que marca un producto como nuevo",
      "info": "Poné esta misma etiqueta en el producto para que aparezca el cartel.",
      "default": "nuevo"
    },

    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo del contenido",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Ancho de cada tarjeta",
      "min": 180,
      "max": 420,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Separación entre tarjetas",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "media_bg",
      "label": "Fondo de las imágenes",
      "default": "#F2F2F2"
    },
    {
      "type": "color",
      "id": "new_color",
      "label": "Color del cartel \"Lo nuevo\"",
      "default": "#B45309"
    },
    {
      "type": "color",
      "id": "sale_color",
      "label": "Color del cartel \"SALE\"",
      "default": "#C2410C"
    },
    {
      "type": "color",
      "id": "off_color",
      "label": "Color del porcentaje de descuento",
      "default": "#15803D"
    },
    {
      "type": "color",
      "id": "arrow_bg",
      "label": "Fondo de las flechas",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Color de las flechas",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio arriba",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio abajo",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Carrusel de productos"
    }
  ]
}
{% endschema %}