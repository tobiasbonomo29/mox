{%- liquid
  assign s = section.settings
  assign img = s.image
  assign img_mobile = s.image_mobile | default: s.image
-%}
<section class="mox-hero" aria-labelledby="mox-hero-{{ section.id }}">
  <figure class="mox-hero__media">
    {%- if img != blank -%}
      <picture>
        {%- if s.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ img_mobile | image_url: width: 600 }} 600w, {{ img_mobile | image_url: width: 900 }} 900w, {{ img_mobile | image_url: width: 1200 }} 1200w"
            sizes="100vw"
            width="{{ img_mobile.width }}"
            height="{{ img_mobile.height }}"
          >
        {%- endif -%}
        {{
          img
          | image_url: width: 2400
          | image_tag:
            widths: '600, 900, 1200, 1600, 2000, 2400, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: s.image_alt,
            style: s.focal_css
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </figure>

  <div class="mox-hero__overlay">
    <div class="mox-container">
      <div class="mox-hero__content">
        {%- if s.eyebrow != blank -%}<p class="mox-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h1 class="mox-hero__title" id="mox-hero-{{ section.id }}">{{ s.heading }}</h1>
        {%- if s.text != blank -%}<p class="mox-hero__text">{{ s.text }}</p>{%- endif -%}
        <div class="mox-hero__actions">
          {%- if s.cta_label != blank -%}
            <a class="mox-btn" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label }}</a>
          {%- endif -%}
          {%- if s.cta2_label != blank -%}
            <a class="mox-btn mox-btn--outline" href="{{ s.cta2_link | default: '#comparar' }}">{{ s.cta2_label }}</a>
          {%- endif -%}
        </div>
        {%- if s.show_lines -%}
          <ul class="mox-hero__lines" aria-label="Líneas">
            {%- for n in (1..3) -%}
              {%- liquid
                assign kn = 'mox_line_' | append: n | append: '_name'
                assign kc = 'mox_line_' | append: n | append: '_color'
                assign kl = 'mox_line_' | append: n | append: '_lens'
              -%}
              <li class="mox-line-tag" style="--mox-line-color: {{ settings[kc] }};"><span class="mox-line-tag__dot" aria-hidden="true"></span>{{ settings[kn] }} <span class="mox-line-tag--small">· {{ settings[kl] | downcase }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if s.promo != blank -%}<p class="mox-hero__promo">{{ s.promo }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portada MÖX",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Título (H1)", "default": "Un anteojo para cada momento de tu día." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Conocé las líneas Mañana, Tarde y Noche y elegí la que acompaña tu rutina." },
    { "type": "text", "id": "cta_label", "label": "Botón principal", "default": "Explorar anteojos" },
    { "type": "url", "id": "cta_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "cta2_label", "label": "Botón secundario", "default": "Comparar líneas" },
    { "type": "text", "id": "cta2_link", "label": "Enlace del botón secundario", "default": "#comparar", "info": "Ancla al comparador de esta página o una URL." },
    { "type": "checkbox", "id": "show_lines", "label": "Mostrar las tres líneas", "default": true },
    { "type": "text", "id": "promo", "label": "Promoción vigente (opcional)", "info": "Solo si existe en Shopify. Se muestra con menor jerarquía que el producto." },
    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "image", "label": "Imagen (escritorio)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagen para celular", "info": "Recorte vertical u horizontal propio para móvil. Si no hay, se usa la de escritorio." },
    { "type": "text", "id": "image_alt", "label": "Texto alternativo", "default": "Anteojos MÖX sobre un escritorio junto a una computadora" },
    { "type": "text", "id": "focal_css", "label": "Encuadre (CSS)", "default": "object-position: 60% 50%;", "info": "Ej. object-position: 70% 50%;" }
  ],
  "presets": [{ "name": "Portada MÖX" }]
}
{% endschema %}
