{%- comment -%}
  MOX · Comparador de líneas. Solo muestra datos verificables: color del
  cristal, momento del día, nivel de filtrado (si se cargó), armazones y
  precios reales de la colección de cada línea.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- capture rows -%}
  {%- for n in (1..3) -%}
    {%- liquid
      assign kn = 'mox_line_' | append: n | append: '_name'
      assign kc = 'mox_line_' | append: n | append: '_color'
      assign kl = 'mox_line_' | append: n | append: '_lens'
      assign kv = 'mox_line_' | append: n | append: '_level'
      assign ks = 'mox_line_' | append: n | append: '_summary'
      assign kcol = 'mox_line_' | append: n | append: '_collection'
      assign col = settings[kcol]
      assign frames = ''
      assign single_min = 0
      assign kit_min = 0
      for item in col.products
        capture raw
          render 'mox-product-meta', product: item
        endcapture
        assign m = raw | split: '|'
        if frames != ''
          assign frames = frames | append: ', '
        endif
        assign frames = frames | append: m[3]
        if single_min == 0 or item.price_max < single_min
          assign single_min = item.price_max
        endif
        if kit_min == 0 or item.price_min < kit_min
          assign kit_min = item.price_min
        endif
      endfor
      assign url = routes.all_products_collection_url
      if col != blank
        assign url = col.url
      endif
    -%}
    {{- n }}~{{ settings[kn] }}~{{ settings[kc] }}~{{ settings[kl] }}~{{ settings[kv] }}~{{ settings[ks] }}~{{ frames }}~{{ single_min }}~{{ kit_min }}~{{ url }}^
  {%- endfor -%}
{%- endcapture -%}
{%- assign lines = rows | split: '^' -%}

<section class="mox-section{% if s.surface %} mox-section--surface{% endif %}" id="comparar" aria-labelledby="mox-compare-{{ section.id }}">
  <div class="mox-container">
    <div class="mox-section__head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="mox-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="mox-heading" id="mox-compare-{{ section.id }}">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<p class="mox-lead">{{ s.text }}</p>{%- endif -%}
      </div>
    </div>

    <div class="mox-compare__table-wrap">
      <table class="mox-compare__table">
        <caption class="visually-hidden">Comparación de las líneas Mañana, Tarde y Noche</caption>
        <thead>
          <tr>
            <td></td>
            {%- for line in lines -%}
              {%- assign c = line | split: '~' -%}
              <th scope="col" style="--mox-line-color: {{ c[2] }};">{{ c[1] }}</th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{{ s.lens_label }}</th>
            {%- for line in lines -%}
              {%- assign c = line | split: '~' -%}
              <td><span class="mox-compare__swatch" style="--mox-line-color: {{ c[2] }};"><span class="mox-compare__lens" aria-hidden="true"></span>{{ c[3] }}</span></td>
            {%- endfor -%}
          </tr>
          <tr>
            <th scope="row">{{ s.moment_label }}</th>
            {%- for line in lines -%}
              {%- assign c = line | split: '~' -%}
              <td>{{ c[5] }}</td>
            {%- endfor -%}
          </tr>
          {%- assign first = lines.first | split: '~' -%}
          {%- if first[4] != blank -%}
            <tr>
              <th scope="row">{{ s.level_label }}</th>
              {%- for line in lines -%}
                {%- assign c = line | split: '~' -%}
                <td>{{ c[4] }}</td>
              {%- endfor -%}
            </tr>
          {%- endif -%}
          <tr>
            <th scope="row">{{ s.frames_label }}</th>
            {%- for line in lines -%}
              {%- assign c = line | split: '~' -%}
              <td>{{ c[6] }}</td>
            {%- endfor -%}
          </tr>
          <tr>
            <th scope="row">{{ s.price_label }}</th>
            {%- for line in lines -%}
              {%- assign c = line | split: '~' -%}
              {%- assign single = c[7] | plus: 0 -%}
              {%- assign kit = c[8] | plus: 0 -%}
              <td>{% if single > 0 %}{{ single | money }}{% if kit < single %}<br><span class="mox-line-tag--small">Desde {{ kit | money }} c/u en kit de 3</span>{% endif %}{% endif %}</td>
            {%- endfor -%}
          </tr>
          <tr>
            <td></td>
            {%- for line in lines -%}
              {%- assign c = line | split: '~' -%}
              <td><a class="mox-btn mox-btn--outline" href="{{ c[9] }}">{{ s.view_label }} {{ c[1] }}</a></td>
            {%- endfor -%}
          </tr>
        </tbody>
      </table>
    </div>

    <ul class="mox-compare__cards" role="list">
      {%- for line in lines -%}
        {%- assign c = line | split: '~' -%}
        {%- assign single = c[7] | plus: 0 -%}
        {%- assign kit = c[8] | plus: 0 -%}
        <li class="mox-compare__card" style="--mox-line-color: {{ c[2] }};">
          <h3>{{ c[1] }}</h3>
          <dl>
            <dt>{{ s.lens_label }}</dt>
            <dd><span class="mox-compare__swatch"><span class="mox-compare__lens" aria-hidden="true"></span>{{ c[3] }}</span></dd>
            <dt>{{ s.moment_label }}</dt>
            <dd>{{ c[5] }}</dd>
            {%- if c[4] != blank -%}
              <dt>{{ s.level_label }}</dt>
              <dd>Nivel {{ c[4] }}</dd>
            {%- endif -%}
            <dt>{{ s.frames_label }}</dt>
            <dd>{{ c[6] }}</dd>
            {%- if single > 0 -%}
              <dt>{{ s.price_label }}</dt>
              <dd>{{ single | money }}{% if kit < single %} · desde {{ kit | money }} c/u en kit de 3{% endif %}</dd>
            {%- endif -%}
          </dl>
          <a class="mox-btn mox-btn--outline" href="{{ c[9] }}">{{ s.view_label }} {{ c[1] }}</a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if s.note != blank -%}<p class="mox-compare__note">{{ s.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Comparador MOX",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Los datos salen de Configuración del tema → MOX y de los productos de cada colección. No agregues porcentajes de filtrado ni beneficios que no estén verificados."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Comparar"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Mañana, Tarde y Noche lado a lado"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Las tres líneas tienen el mismo sistema de kits. Lo que cambia es el color del cristal y el momento del día para el que están pensadas."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota al pie",
      "default": "En los kits de 2 y 3 anteojos podés combinar líneas y armazones."
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Fondo blanco",
      "default": true
    },
    {
      "type": "text",
      "id": "lens_label",
      "label": "Etiqueta: Cristal",
      "default": "Cristal"
    },
    {
      "type": "text",
      "id": "moment_label",
      "label": "Etiqueta: Momento del día",
      "default": "Momento del día"
    },
    {
      "type": "text",
      "id": "level_label",
      "label": "Etiqueta: Nivel de filtrado",
      "default": "Nivel de filtrado"
    },
    {
      "type": "text",
      "id": "frames_label",
      "label": "Etiqueta: Armazones",
      "default": "Armazones"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Etiqueta: Precio por anteojo",
      "default": "Precio por anteojo"
    },
    {
      "type": "text",
      "id": "view_label",
      "label": "Etiqueta: Ver",
      "default": "Ver"
    }
  ],
  "presets": [
    {
      "name": "Comparador MOX"
    }
  ]
}
{% endschema %}
