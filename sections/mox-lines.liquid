{%- comment -%}
  MOX · Selector de líneas. Los datos de cada línea (nombre, color, cristal,
  descripción, colección) salen de Configuración del tema → MOX.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="mox-section{% if s.surface %} mox-section--surface{% endif %}" id="lineas" aria-labelledby="mox-lines-{{ section.id }}">
  <div class="mox-container">
    <div class="mox-section__head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="mox-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="mox-heading" id="mox-lines-{{ section.id }}">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<p class="mox-lead">{{ s.text }}</p>{%- endif -%}
      </div>
    </div>
    <ul class="mox-lines{% if s.video_cards %} mox-lines--video{% endif %}{% if s.guide %} mox-lines--guide{% endif %}" role="list">
      {%- for n in (1..3) -%}
        {%- liquid
          assign kn = 'mox_line_' | append: n | append: '_name'
          assign kc = 'mox_line_' | append: n | append: '_color'
          assign kl = 'mox_line_' | append: n | append: '_lens'
          assign ks = 'mox_line_' | append: n | append: '_summary'
          assign kcol = 'mox_line_' | append: n | append: '_collection'
          assign ki = 'mox_line_' | append: n | append: '_image'
          assign kv = 'video_' | append: n
          assign video = s[kv]
          assign level_key = 'mox_line_' | append: n | append: '_level'
          assign col = settings[kcol]
          assign image = settings[ki]
          if image == blank and col != blank
            assign image = col.products.first.featured_image
          endif
          assign url = routes.all_products_collection_url
          if col != blank
            assign url = col.url
          endif
          assign count = col.products_count | default: 0
        -%}
        <li>
          <article class="mox-line-card" style="--mox-line-color: {{ settings[kc] }};">
            <span class="mox-line-card__media">
              {%- if s.video_cards -%}
                {%- comment -%}
                  Video vertical 9:16 a tamaño completo. Mientras no haya video se usa la
                  foto de la línea como marcador (o el color de la línea si no hay foto).
                {%- endcomment -%}
                {%- if video != blank -%}
                  {{ video | video_tag: image_size: '720x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'mox-line-card__video' }}
                {%- elsif image != blank -%}
                  {{ image | image_url: width: 720 | image_tag: widths: '360, 540, 720', sizes: '(min-width: 750px) 30vw, 70vw', loading: 'lazy', alt: '', class: 'mox-line-card__poster' }}
                {%- endif -%}
                {%- if video == blank and request.design_mode -%}
                  <span class="mox-line-card__pending">Video pendiente: cargalo en esta sección</span>
                {%- endif -%}
              {%- elsif image != blank -%}
                {{ image | image_url: width: 800 | image_tag: widths: '360, 540, 800', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: '', width: image.width, height: image.height }}
              {%- endif -%}
            </span>
            <div class="mox-line-card__body">
              <p class="mox-line-tag mox-line-tag--small"><span class="mox-line-tag__dot" aria-hidden="true"></span>{{ s.lens_label }} {{ settings[kl] | downcase }}</p>
              <h3 class="mox-line-card__name"><a href="{{ url }}">{{ settings[kn] }}</a></h3>
              {%- if settings[ks] != blank -%}<p class="mox-line-card__text">{{ settings[ks] }}</p>{%- endif -%}
              {%- if s.guide -%}
                {%- if settings[level_key] != blank -%}<p class="mox-line-card__text">{{ s.level_label }}: {{ settings[level_key] }}</p>{%- endif -%}
                {%- if s.guide_note != blank -%}<p class="mox-line-card__text">{{ s.guide_note }}</p>{%- endif -%}
              {%- endif -%}
              <p class="mox-line-card__meta">
                <span>{% if s.show_count and count > 0 %}{{ count }} {% if count == 1 %}armazón{% else %}armazones{% endif %}{% endif %}</span>
                <span class="mox-link" aria-hidden="true">{{ s.view_label }} {{ settings[kn] }}{% render 'mox-icon', name: 'arrow' %}</span>
              </p>
            </div>
          </article>
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.video_cards and s.swipe_hint != blank -%}
      <p class="mox-swipe-hint mox-swipe-hint--mobile" aria-hidden="true">{{ s.swipe_hint }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Líneas MOX",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Nombre, color, cristal, descripción, imagen y colección de cada línea se editan en Configuración del tema → MOX."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Tres líneas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Elegí según el momento del día"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Cada línea se distingue por el color de su cristal. Los armazones se eligen aparte."
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Fondo blanco",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "guide",
      "label": "Guía con foto e información",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "video_cards",
      "label": "Tarjetas de video vertical",
      "info": "Videos 9:16 en carrusel, con reproducción automática y sin sonido. Sin video se usa la foto de la línea.",
      "default": false
    },
    {
      "type": "text",
      "id": "swipe_hint",
      "label": "Indicación de deslizar",
      "default": "Deslizá para ver más →",
      "info": "Se muestra en celular, donde los videos se deslizan de costado."
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "Video Mañana"
    },
    {
      "type": "video",
      "id": "video_2",
      "label": "Video Tarde"
    },
    {
      "type": "video",
      "id": "video_3",
      "label": "Video Noche"
    },
    {
      "type": "text",
      "id": "view_label",
      "label": "Texto antes del nombre en el enlace",
      "default": "Ver"
    },
    {
      "type": "text",
      "id": "lens_label",
      "label": "Etiqueta del cristal",
      "default": "Cristal"
    },
    {
      "type": "text",
      "id": "level_label",
      "label": "Etiqueta del filtrado",
      "default": "Filtrado"
    },
    {
      "type": "textarea",
      "id": "guide_note",
      "label": "Consejo de la guía",
      "default": "Elegí tu armazón y combinalo con otras líneas en tu kit."
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Mostrar cantidad de armazones",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Líneas MOX"
    }
  ]
}
{% endschema %}
