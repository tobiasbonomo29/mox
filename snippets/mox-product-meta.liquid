{%- comment -%}
  Devuelve, separados por "|", los datos de presentación de un producto MOX:
  índice de línea | nombre de línea | color de línea | armazón (Capitalizado) | título para mostrar | handle del armazón

  Los productos MOX usan el handle {línea}-armazon-{armazón} (ej. noche-armazon-marron),
  la misma convención de la que depende el kit. Si el producto no la sigue,
  se devuelve el título original y el índice 0.

  Uso:
    {%- capture meta -%}{% render 'mox-product-meta', product: product %}{%- endcapture -%}
    {%- assign meta = meta | split: '|' -%}

  @param product {product}
{%- endcomment -%}
{%- liquid
  assign line_index = 0
  assign line_name = ''
  assign line_color = ''
  assign frame_name = ''
  assign frame_handle = ''
  assign display = product.title

  if product.handle contains '-armazon-'
    assign parts = product.handle | split: '-armazon-'
    assign prefix = parts.first
    assign frame_handle = parts.last

    for n in (1..3)
      assign k_handle = 'mox_line_' | append: n | append: '_handle'
      if settings[k_handle] == prefix
        assign line_index = n
        assign k_name = 'mox_line_' | append: n | append: '_name'
        assign k_color = 'mox_line_' | append: n | append: '_color'
        assign line_name = settings[k_name]
        assign line_color = settings[k_color]
      endif
    endfor

    assign raw_frame = product.title | split: ' - ' | last | strip
    assign lower = raw_frame | downcase
    if lower contains 'armazon ' or lower contains 'armazón '
      assign frame_lower = lower | remove_first: 'armazón ' | remove_first: 'armazon ' | strip
    else
      assign frame_lower = frame_handle | replace: '-', ' '
    endif
    assign frame_name = frame_lower | capitalize

    if line_index > 0
      assign display = line_name | append: ' · Armazón ' | append: frame_lower
    endif
  endif
-%}
{{- line_index }}|{{ line_name }}|{{ line_color }}|{{ frame_name }}|{{ display }}|{{ frame_handle -}}
