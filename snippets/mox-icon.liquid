{%- comment -%}
  Íconos de línea MOX (SVG en línea, decorativos).
  @param name {string} truck | return | lock | mail | arrow | check | plus
{%- endcomment -%}
<svg class="mox-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'truck' -%}
      <path d="M3 6.5h11v9H3z"/><path d="M14 9.5h3.6l3.4 3.4v2.6h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17.5" cy="17.5" r="1.6"/>
    {%- when 'return' -%}
      <path d="M8.5 7.5 5 11l3.5 3.5"/><path d="M5.5 11H15a4 4 0 0 1 0 8h-3"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/>
    {%- when 'mail' -%}
      <rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'document' -%}
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/>
      <path d="M14 3v5h5"/>
  {%- endcase -%}
</svg>
