{%- comment -%}
  MOX · Compra en la ficha de producto.
  Reemplaza a "Info de producto", "Etiquetas MOX" y "Kits MOX" con un único
  estado para: título, precio, armazón, kit, resumen, botón y barra móvil.

  Modelo real: cada línea + armazón es un producto ({línea}-armazon-{armazón}) con
  una opción "Kit" (1, 2 o 3 anteojos) cuyo precio es el precio POR UNIDAD.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign p = closest.product
  if p == blank
    assign p = product
  endif
-%}

{%- if p == blank -%}
  {%- if request.design_mode -%}
    <div class="mox-empty" {{ block.shopify_attributes }}>Este bloque necesita una ficha de producto.</div>
  {%- endif -%}
{%- else -%}
  {%- liquid
    capture meta_raw
      render 'mox-product-meta', product: p
    endcapture
    assign meta = meta_raw | split: '|'
    assign line_index = meta[0] | plus: 0
    assign line_name = meta[1]
    assign line_color = meta[2]
    assign frame_name = meta[3]
    assign display_title = meta[4]
    assign frame_handle = meta[5]
    assign frame_lower = frame_name | downcase

    assign line_summary = ''
    assign line_lens = ''
    assign line_url = routes.all_products_collection_url
    assign line_prefix = ''
    if line_index > 0
      assign k = 'mox_line_' | append: line_index | append: '_summary'
      assign line_summary = settings[k]
      assign k = 'mox_line_' | append: line_index | append: '_lens'
      assign line_lens = settings[k]
      assign k = 'mox_line_' | append: line_index | append: '_collection'
      if settings[k] != blank
        assign line_url = settings[k].url
      endif
      assign k = 'mox_line_' | append: line_index | append: '_handle'
      assign line_prefix = settings[k]
    endif

    comment
      Índice de la opción "Kit" y nivel de cada variante (primer número del valor).
    endcomment
    assign kit_index = -1
    for opt in p.options_with_values
      if opt.name == 'Kit'
        assign kit_index = forloop.index0
      endif
    endfor

    assign selected = p.selected_variant
    assign initial_tier = 0
    for t in (1..3)
      assign t_str = t | append: ''
      assign found = nil
      for v in p.variants
        if kit_index > -1
          assign value = v.options[kit_index]
        else
          assign value = v.title
        endif
        if value contains t_str
          assign found = v
          break
        endif
      endfor
      if kit_index == -1 and t == 1 and found == nil
        assign found = p.variants.first
      endif
      if found and selected and found.id == selected.id
        assign initial_tier = t
      endif
    endfor
    if initial_tier == 0
      assign initial_tier = 1
    endif
  -%}

  <mox-buy
    class="mox-buy"
    data-block-id="{{ block.id }}"
    data-initial-tier="{{ initial_tier }}"
    style="--mox-line-color: {{ line_color | default: '#181818' }};"
    {{ block.shopify_attributes }}
  >
    <script type="application/json" data-mox-catalog>
      {
        "moneyFormat": {{ shop.money_format | json }},
        "currency": {{ cart.currency.iso_code | json }},
        "current": {{ p.handle | json }},
        "ui": { "missingFrame": {{ s.missing_frame | json }}, "chooseFrame": {{ s.choose_frame | json }}, "chooseAll": {{ s.choose_all | json }}, "scrollToKit": {{ s.scroll_to_kit | json }}, "priceLabel": {{ s.price_label | json }}, "priceLabelKit": {{ s.price_label_kit | json }},
          "unitLegend": {{ s.unit_legend | json }},
          "tierTotal": {{ s.tier_total | json }},
          "chooseLine": {{ s.choose_line | json }},
          "unitPrice": {{ s.unit_price | json }},
          "unitPriceFrom": {{ s.unit_price_from | json }},
          "unavailable": {{ s.unavailable | json }},
          "soldOutShort": {{ s.sold_out_short | json }},
          "notInKit": {{ s.not_in_kit | json }},
          "summaryMissing": {{ s.summary_missing | json }},
          "stickyKit": {{ s.sticky_kit | json }},
          "soldOut": {{ settings.mox_t_soldout | json }},
          "adding": {{ settings.mox_t_adding | json }},
          "added": {{ settings.mox_t_added | json }},
          "announceSingle": {{ settings.mox_t_announce_single | json }},
          "announceKit": {{ settings.mox_t_announce_kit | json }},
          "reviewSelection": {{ settings.mox_t_review_selection | json }},
          "errMissing": {{ settings.mox_t_err_missing | json }},
          "errUnknown": {{ settings.mox_t_err_unknown | json }},
          "errTier": {{ settings.mox_t_err_tier | json }},
          "errSoldOut": {{ settings.mox_t_err_sold_out | json }},
          "errStock": {{ settings.mox_t_err_stock | json }},
          "errGeneric": {{ settings.mox_t_err_generic | json }} },
        "lines": [
          {%- for n in (1..3) -%}
            {%- liquid
              assign kh = 'mox_line_' | append: n | append: '_handle'
              assign kn = 'mox_line_' | append: n | append: '_name'
              assign kc = 'mox_line_' | append: n | append: '_color'
              assign kl = 'mox_line_' | append: n | append: '_lens'
            -%}
            { "index": {{ n }}, "handle": {{ settings[kh] | json }}, "name": {{ settings[kn] | json }}, "color": {{ settings[kc] | json }}, "lens": {{ settings[kl] | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "payments": {
          "installments": {% if settings.mox_installments_enabled %}{ "count": {{ settings.mox_installments_count }}, "text": {{ settings.mox_installments_text | json }} }{% else %}null{% endif %},
          "cash": {% if settings.mox_cash_enabled %}{ "percent": {{ settings.mox_cash_percent }}, "label": {{ settings.mox_cash_label | json }} }{% else %}null{% endif %}
        },
        "products": [
          {%- assign first_item = true -%}
          {%- for item in collections.all.products limit: 50 -%}
            {%- if item.handle contains '-armazon-' -%}
              {%- liquid
                capture item_meta_raw
                  render 'mox-product-meta', product: item
                endcapture
                assign im = item_meta_raw | split: '|'
              -%}
              {%- unless first_item -%},{%- endunless -%}
              {%- assign first_item = false -%}
              {
                "handle": {{ item.handle | json }},
                "title": {{ item.title | json }},
                "display": {{ im[4] | json }},
                "lineIndex": {{ im[0] | plus: 0 }},
                "frameName": {{ im[3] | json }},
                "frameHandle": {{ im[5] | json }},
                "url": {{ item.url | json }},
                "image": {% if item.featured_image %}{{ item.featured_image | image_url: width: 160 | json }}{% else %}""{% endif %},
                "options": {{ item.options | json }},
                "variants": [
                  {%- for v in item.variants -%}
                    {
                      "id": {{ v.id }},
                      "title": {{ v.title | json }},
                      "options": {{ v.options | json }},
                      "available": {{ v.available }},
                      "price": {{ v.price }},
                      "compare_at_price": {% if v.compare_at_price %}{{ v.compare_at_price }}{% else %}null{% endif %},
                      "inventoryLimit": {% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}{{ v.inventory_quantity | at_least: 0 }}{% else %}null{% endif %}
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              }
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>

    {%- if s.show_breadcrumb -%}
      <nav class="mox-breadcrumb" aria-label="Ruta de navegación">
        <ol>
          <li><a href="{{ routes.root_url }}">{{ settings.mox_t_breadcrumb_home }}</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">{{ settings.mox_t_breadcrumb_shop }}</a></li>
          {%- if line_index > 0 -%}
            <li><a href="{{ line_url }}">{{ line_name }}</a></li>
          {%- endif -%}
          <li><span aria-current="page">{% if frame_name != blank %}{{ settings.mox_t_frame }} {{ frame_name | downcase }}{% else %}{{ display_title }}{% endif %}</span></li>
        </ol>
      </nav>
    {%- endif -%}

    <header class="mox-buy__header">
      {%- if line_index > 0 -%}
        <p class="mox-line-tag"><span class="mox-line-tag__dot" aria-hidden="true"></span>{{ settings.mox_t_line }} {{ line_name }}{% if line_lens != blank %} · {{ settings.mox_t_lens }} {{ line_lens | downcase }}{% endif %}</p>
      {%- endif -%}
      <h1 class="mox-buy__title">{{ display_title }}</h1>
      {%- if line_summary != blank -%}
        <p class="mox-buy__summary">{{ line_summary }}</p>
      {%- endif -%}
    </header>

    {%- liquid
      assign base_variant = p.selected_or_first_available_variant
      for v in p.variants
        if kit_index > -1
          assign value = v.options[kit_index]
        else
          assign value = v.title
        endif
        assign it_str = initial_tier | append: ''
        if value contains it_str
          assign base_variant = v
          break
        endif
      endfor
      assign base_total = base_variant.price | times: initial_tier
      assign base_price_money = base_variant.price | money
      assign base_compare = base_variant.compare_at_price | default: 0 | times: initial_tier
    -%}
    <div class="mox-price" aria-live="polite">
      <p class="mox-price__label" data-mox-price-label>{% if initial_tier > 1 %}{{ s.price_label_kit }} {{ initial_tier }}{% else %}{{ s.price_label }}{% endif %}</p>
      <div class="mox-price__row">
        <span class="mox-price__current" data-mox-price>{{ base_total | money }}</span>
        <s class="mox-price__compare" data-mox-compare {% unless base_compare > base_total %}hidden{% endunless %}>
          {%- if base_compare > base_total -%}{{ base_compare | money }}{%- endif -%}
        </s>
      </div>
      <p class="mox-price__unit" data-mox-unit-price {% if initial_tier < 2 %}hidden{% endif %}>{{ s.unit_price | replace: '[precio]', base_price_money }}</p>
    </div>

    {%- comment -%}
      Información de compra en desplegables. Cada ítem se muestra solo si tiene
      texto cargado; en el editor se listan los tres con un aviso para completarlos.
    {%- endcomment -%}
    {%- liquid
      assign info_filled = 0
      for n in (1..3)
        assign kt = 'mox_info_' | append: n | append: '_title'
        assign kb = 'mox_info_' | append: n | append: '_body'
        if settings[kt] != blank and settings[kb] != blank
          assign info_filled = info_filled | plus: 1
        endif
      endfor
    -%}
    {%- if info_filled > 0 or request.design_mode -%}
      <div class="mox-accordion mox-accordion--boxed">
        {%- for n in (1..3) -%}
          {%- liquid
            assign kt = 'mox_info_' | append: n | append: '_title'
            assign kb = 'mox_info_' | append: n | append: '_body'
            assign info_title = settings[kt]
            assign info_body = settings[kb]
          -%}
          {%- if info_title != blank and info_body != blank -%}
            <details>
              <summary>{{ info_title }}</summary>
              <div class="mox-accordion__content">{{ info_body }}</div>
            </details>
          {%- elsif info_title != blank and request.design_mode -%}
            <details>
              <summary>{{ info_title }}</summary>
              <div class="mox-accordion__content">
                <p>Cargá el texto de «{{ info_title }}» en este bloque. Este aviso solo se ve en el editor.</p>
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Armazones de esta línea: cada uno es un producto propio. {%- endcomment -%}
    {%- if s.show_frames and line_index > 0 -%}
      <div class="mox-choice">
        <p class="mox-choice__label" id="mox-frames-{{ block.id }}">{{ s.frames_label }} <strong>{{ frame_name }}</strong></p>
        <ul class="mox-frames" aria-labelledby="mox-frames-{{ block.id }}">
          {%- for item in collections.all.products limit: 50 -%}
            {%- assign sib_prefix = line_prefix | append: '-armazon-' -%}
            {%- if item.handle contains sib_prefix -%}
              {%- liquid
                capture sib_raw
                  render 'mox-product-meta', product: item
                endcapture
                assign sm = sib_raw | split: '|'
              -%}
              {%- if sm[0] == meta[0] -%}
                <li>
                  <a
                    class="mox-frame{% if item.handle == p.handle %} is-current{% endif %}{% unless item.available %} is-soldout{% endunless %}"
                    href="{{ item.url }}"
                    {% if item.handle == p.handle %}aria-current="page"{% endif %}
                  >
                    <span class="mox-frame__media">
                      {%- if item.featured_image -%}
                        {{ item.featured_image | image_url: width: 160 | image_tag: width: 80, height: 80, loading: 'lazy', alt: '', widths: '80, 160' }}
                      {%- endif -%}
                    </span>
                    <span class="mox-frame__name">{{ sm[3] }}{% unless item.available %} · {{ s.sold_out_short }}{% endunless %}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- liquid
      comment
        Solo se muestra si al menos otra línea viene con este mismo armazón.
      endcomment
      assign other_lines = 0
      if s.show_lines and line_index > 0
        for n in (1..3)
          if n != line_index
            assign kh = 'mox_line_' | append: n | append: '_handle'
            assign target_handle = settings[kh] | append: '-armazon-' | append: frame_handle
            if all_products[target_handle].id
              assign other_lines = other_lines | plus: 1
            endif
          endif
        endfor
      endif
    -%}
    {%- if other_lines > 0 -%}
      <div class="mox-choice">
        <p class="mox-choice__label" id="mox-lines-{{ block.id }}">{{ s.other_lines_label | replace: '[armazon]', frame_lower }}</p>
        <ul class="mox-line-links" aria-labelledby="mox-lines-{{ block.id }}">
          {%- for n in (1..3) -%}
            {%- liquid
              assign kh = 'mox_line_' | append: n | append: '_handle'
              assign kn = 'mox_line_' | append: n | append: '_name'
              assign kc = 'mox_line_' | append: n | append: '_color'
              assign kl = 'mox_line_' | append: n | append: '_lens'
              assign target_handle = settings[kh] | append: '-armazon-' | append: frame_handle
              assign target = all_products[target_handle]
            -%}
            <li style="--mox-line-color: {{ settings[kc] }};">
              {%- if n == line_index -%}
                <span class="mox-line-link is-current" aria-current="true"><span class="mox-line-tag__dot" aria-hidden="true"></span>{{ settings[kn] }}<small>{{ settings.mox_t_lens }} {{ settings[kl] | downcase }}</small></span>
              {%- elsif target != blank and target.id -%}
                <a class="mox-line-link" href="{{ target.url }}"><span class="mox-line-tag__dot" aria-hidden="true"></span>{{ settings[kn] }}<small>{{ settings.mox_t_lens }} {{ settings[kl] | downcase }}</small></a>
              {%- else -%}
                <span class="mox-line-link is-disabled"><span class="mox-line-tag__dot" aria-hidden="true"></span>{{ settings[kn] }}<small>{{ s.not_in_frame | replace: '[armazon]', frame_lower }}</small></span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <form
      class="mox-buy__form"
      method="post"
      action="{{ routes.cart_add_url }}"
      accept-charset="UTF-8"
      enctype="multipart/form-data"
      novalidate
    >
      <input type="hidden" name="form_type" value="product">
      <input type="hidden" name="utf8" value="✓">
      {%- liquid
        comment
          Sin JavaScript el formulario agrega 1 unidad: siempre con la variante de 1 anteojo,
          para que nunca se cobre una unidad suelta al precio de un kit.
        endcomment
        assign single_variant = base_variant
        for v in p.variants
          if kit_index > -1
            assign value = v.options[kit_index]
          else
            assign value = v.title
          endif
          if value contains '1'
            assign single_variant = v
            break
          endif
        endfor
      -%}
      <input type="hidden" name="id" value="{{ single_variant.id }}">
      <input type="hidden" name="quantity" value="1">

      <fieldset class="mox-tiers">
        <legend class="mox-choice__label">{{ s.kit_title }}</legend>
        {%- for t in (1..3) -%}
          {%- liquid
            assign t_str = t | append: ''
            assign tv = nil
            for v in p.variants
              if kit_index > -1
                assign value = v.options[kit_index]
              else
                assign value = v.title
              endif
              if value contains t_str
                assign tv = v
                break
              endif
            endfor
            if kit_index == -1 and t == 1 and tv == nil
              assign tv = p.variants.first
            endif
          -%}
          {%- if tv -%}
            {%- assign tv_total = tv.price | times: t -%}
            {%- assign tv_total_money = tv_total | money -%}
            <label class="mox-tier{% if t == initial_tier %} is-selected{% endif %}{% unless tv.available %} is-soldout{% endunless %}" data-mox-tier-card="{{ t }}">
              <input
                type="radio"
                name="mox-tier-{{ block.id }}"
                value="{{ t }}"
                data-mox-tier
                {% if t == initial_tier %}checked{% endif %}
                {% unless tv.available %}disabled{% endunless %}
              >
              <span class="mox-tier__mark" aria-hidden="true"></span>
              <span class="mox-tier__body">
                {%- assign tier_label_key = 'tier_' | append: t | append: '_label' -%}
                <span class="mox-tier__name">{{ s[tier_label_key] }}</span>
                <span class="mox-tier__note">{% if t == 1 %}{{ s.single_note }}{% else %}{{ s.kit_note }}{% endif %}{% unless tv.available %} · {{ s.sold_out_short }}{% endunless %}</span>
                {%- if t > 1 and s.kit_badge != blank -%}<span class="mox-tier__badge">{% render 'mox-icon', name: 'truck' %}{{ s.kit_badge }}</span>{%- endif -%}
              </span>
              <span class="mox-tier__prices">
                <span class="mox-tier__unit">{{ tv.price | money }} <small>c/u</small></span>
                {%- if t > 1 -%}<span class="mox-tier__total" data-mox-tier-total>{{ s.tier_total | replace: '[precio]', tv_total_money }}</span>{%- endif -%}
              </span>
            </label>
          {%- endif -%}
        {%- endfor -%}
      </fieldset>

      <div class="mox-units" data-mox-units {% if initial_tier < 2 %}hidden{% endif %}></div>

      <template data-mox-unit-template>
        <fieldset class="mox-unit">
          <legend class="mox-unit__legend" data-mox-unit-legend>{{ s.unit_legend | replace: '[n]', '' | strip }}</legend>
          <img class="mox-unit__image" data-mox-unit-image width="56" height="56" alt="" hidden>
          <div class="mox-unit__fields">
            <div class="mox-field">
              <label class="mox-field__label" data-mox-unit-line-label>{{ s.unit_line_label }}</label>
              <span class="mox-field__control">
                <span class="mox-field__dot" data-mox-unit-dot aria-hidden="true"></span>
                <select data-mox-unit-line>
                  {%- for n in (1..3) -%}
                    {%- assign kn = 'mox_line_' | append: n | append: '_name' -%}
                    {%- assign kl = 'mox_line_' | append: n | append: '_lens' -%}
                    <option value="{{ n }}">{{ settings[kn] }} · {{ settings.mox_t_lens | downcase }} {{ settings[kl] | downcase }}</option>
                  {%- endfor -%}
                </select>
              </span>
            </div>
            <div class="mox-field">
              <label class="mox-field__label" data-mox-unit-frame-label>{{ s.unit_frame_label }}</label>
              <span class="mox-field__control"><select data-mox-unit-frame></select></span>
            </div>
          </div>
          <p class="mox-unit__status" data-mox-unit-status></p>
        </fieldset>
      </template>

      <div class="mox-order" data-mox-summary-wrap {% if initial_tier < 2 %}hidden{% endif %}>
        <p class="mox-order__title">{{ s.summary_title }}</p>
        <ul class="mox-order__list" data-mox-summary></ul>
      </div>

      <p class="mox-alert" role="alert" data-mox-errors hidden></p>

      <button type="submit" class="button mox-buy__submit" data-mox-submit data-label-add="{{ s.button_label | escape }}" {% unless base_variant.available %}disabled{% endunless %}>
        <span data-mox-submit-text>{% if base_variant.available %}{{ s.button_label }}{% else %}{{ settings.mox_t_soldout }}{% endif %}</span>
      </button>
      <p class="visually-hidden" aria-live="polite" data-mox-live></p>
    </form>

    {%- if s.show_certificates -%}
      {%- render 'mox-certificates', compact: true -%}
    {%- endif -%}

    <ul class="mox-assurance">
      {%- comment -%} El envío gratis es desde 2 anteojos: el texto cambia con la opción elegida. {%- endcomment -%}
      {%- if settings.mox_shipping_text_single != blank -%}
        <li data-mox-ship="single" {% if initial_tier > 1 %}hidden{% endif %}>{% render 'mox-icon', name: 'truck' %}<span>{{ settings.mox_shipping_text_single }}</span></li>
      {%- endif -%}
      {%- if settings.mox_shipping_text != blank -%}
        <li data-mox-ship="kit" {% if initial_tier < 2 %}hidden{% endif %}>{% render 'mox-icon', name: 'truck' %}<span>{{ settings.mox_shipping_text }}</span></li>
      {%- endif -%}
      {%- if settings.mox_returns_text != blank -%}
        <li>{% render 'mox-icon', name: 'return' %}<span>{{ settings.mox_returns_text }}</span></li>
      {%- endif -%}
      <li>{% render 'mox-icon', name: 'lock' %}<span>{{ s.payment_note }}</span></li>
      {%- if shop.email != blank -%}
        <li>{% render 'mox-icon', name: 'mail' %}<span>{{ s.contact_note }} <a href="mailto:{{ shop.email }}">{{ shop.email }}</a></span></li>
      {%- endif -%}
    </ul>

    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="mox-payment-icons" aria-label="Medios de pago">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="mox-sticky-buy" data-mox-sticky aria-hidden="true">
      <div class="mox-sticky-buy__info">
        <span class="mox-sticky-buy__name" data-mox-sticky-label>{% if initial_tier > 1 %}{{ s.sticky_kit | replace: '[n]', initial_tier }}{% else %}{{ display_title }}{% endif %}</span>
        <span class="mox-sticky-buy__price" data-mox-sticky-price>{{ base_total | money }}</span>
      </div>
      <button type="button" class="button mox-sticky-buy__button" data-mox-sticky-submit data-label-add="{{ s.button_label | escape }}" tabindex="-1">
        <span data-mox-submit-text>{{ s.button_label }}</span>
      </button>
    </div>
  </mox-buy>

  <script type="module" src="{{ 'mox-buy.js' | asset_url }}"></script>
{%- endif -%}

{% schema %}
{
  "name": "Compra MOX",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Título, precio, armazón, kit y botón con un único estado. Los precios salen de las variantes \"Kit\" de cada producto; las líneas y condiciones se editan en Configuración del tema → MOX."
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
