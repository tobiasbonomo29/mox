{%- liquid
  assign s = block.settings
  assign gid = block.id
  assign p = closest.product

  assign pct = 0
  if p.compare_at_price_max > p.price_min
    assign diff = p.compare_at_price_max | minus: p.price_min
    assign pct = diff | times: 100 | divided_by: p.compare_at_price_max
  endif

  assign cuota = p.price_min | divided_by: s.cuotas | money
  assign precio = p.price_min | money
-%}

<div id="mox-tags-{{ gid }}" class="mox-tags" {{ block.shopify_attributes }}>
  {%- for i in (1..4) -%}
    {%- liquid
      assign k_text = 'text_' | append: i
      assign k_bg = 'bg_' | append: i
      assign k_fg = 'fg_' | append: i
      assign k_cond = 'cond_' | append: i
      assign k_tag = 'tag_' | append: i

      assign txt = s[k_text]
      assign cond = s[k_cond]
      assign tagv = s[k_tag]
      assign show = false

      if txt != blank
        case cond
          when 'always'
            assign show = true
          when 'tag'
            if tagv != blank and p.tags contains tagv
              assign show = true
            endif
          when 'sale'
            if pct > 0
              assign show = true
            endif
          when 'instock'
            if p.available
              assign show = true
            endif
          when 'soldout'
            unless p.available
              assign show = true
            endunless
        endcase
      endif

      assign final = txt | replace: '{descuento}', pct | replace: '{cuota}', cuota | replace: '{precio}', precio
    -%}
    {%- if show -%}
      <span class="mox-tag" style="background: {{ s[k_bg] }}; color: {{ s[k_fg] }};">{{ final }}</span>
    {%- endif -%}
  {%- endfor -%}
</div>

<style>
  #mox-tags-{{ gid }} {
    display: flex;
    flex-direction: column;
    align-items: {% if s.align == 'center' %}center{% elsif s.align == 'right' %}flex-end{% else %}flex-start{% endif %};
    gap: {{ s.gap }}px;
    width: 100%;
    margin-top: {{ s.margin_top }}px;
  }
  #mox-tags-{{ gid }} .mox-tag {
    display: inline-block;
    width: auto;
    max-width: 100%;
    padding: {{ s.pad_y }}px {{ s.pad_x }}px;
    border-radius: {{ s.radius }}px;
    font-size: {{ s.font_size }}px;
    line-height: 1.25;
    font-weight: {% if s.bold %}600{% else %}400{% endif %};
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-sizing: border-box;
  }
</style>

{% schema %}
